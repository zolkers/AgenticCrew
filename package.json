{
  "name": "agentos",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "backend:install": "python -m pip install -e \"backend[dev]\"",
    "backend:lint": "cd backend && python -m ruff check .",
    "backend:test": "cd backend && python -m pytest tests -q",
    "backend:typecheck": "cd backend && python -m mypy agentos_core",
    "backend:quality": "npm run backend:test && npm run backend:lint && npm run backend:typecheck",
    "desktop:test": "cd src-tauri && cargo test",
    "lint": "npm run lint -w frontend",
    "typecheck": "npm run typecheck -w frontend",
    "test": "npm run test -w frontend",
    "coverage": "npm run coverage -w frontend",
    "frontend:quality": "npm run lint && npm run typecheck && npm run coverage",
    "quality": "npm run frontend:quality && npm run backend:quality"
  }
}
